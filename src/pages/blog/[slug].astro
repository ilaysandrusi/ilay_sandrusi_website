---
import { render } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import MobileBar from "../../components/MobileBar.astro";
import { formatDate, getGuides } from "../../data/guides";
import { absUrl, base, pageTitle, siteName } from "../../data/site";

export async function getStaticPaths() {
  const guides = await getGuides();
  return guides.map((guide) => ({ params: { slug: guide.id }, props: { guide } }));
}

const { guide } = Astro.props;
const { Content } = await render(guide);
const { title, description, date, updated, tag, draft, video, poster, videoDuration, videoNote, videoCredit } = guide.data;

const isoDate = date.toISOString().slice(0, 10);

const abs = (path: string) => absUrl(path, Astro.site);
const siteUrl = abs("");
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const person = { "@id": `${siteUrl}#person` }; // defined once in Layout.astro
const imageUrl = poster ? abs(poster) : abs("og-image.png");

const article = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BlogPosting",
      "@id": `${pageUrl}#article`,
      headline: title,
      description,
      image: imageUrl,
      datePublished: isoDate,
      dateModified: (updated ?? date).toISOString().slice(0, 10),
      inLanguage: "he-IL",
      url: pageUrl,
      mainEntityOfPage: pageUrl,
      isPartOf: { "@id": `${siteUrl}#website` },
      author: person,
      publisher: person,
      ...(video && poster ? { video: { "@id": `${pageUrl}#video` } } : {}),
    },
    // Google needs a thumbnail for a video, so the video is described only when there is a poster
    ...(video && poster
      ? [
          {
            "@type": "VideoObject",
            "@id": `${pageUrl}#video`,
            name: title,
            description,
            thumbnailUrl: abs(poster),
            contentUrl: abs(video),
            uploadDate: isoDate,
            ...(videoDuration ? { duration: videoDuration } : {}),
            inLanguage: "he-IL",
          },
        ]
      : []),
    {
      "@type": "BreadcrumbList",
      "@id": `${pageUrl}#breadcrumb`,
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "דף הבית", item: siteUrl },
        { "@type": "ListItem", position: 2, name: "בלוג", item: abs("blog/") },
        { "@type": "ListItem", position: 3, name: title },
      ],
    },
  ],
};
---

<Layout title={pageTitle(title)} description={description} ogType="article" noindex={draft}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(article)} />
  <Header />
  <main id="main" class="guide-page">
    <article class="guide-inner">
      <a class="back" href={`${base}blog/`}>חזרה לבלוג</a>

      <header class="head">
        <p class="meta">
          {tag && <span class="tag">{tag}</span>}
          {draft && <span class="tag draft">טיוטה</span>}
          <span class="byline">
            <span class="author">{siteName}</span>
            <span aria-hidden="true">·</span>
            <time datetime={isoDate}>{formatDate(date)}</time>
          </span>
        </p>
        <h1>{title}</h1>
        <p class="lead">{description}</p>
      </header>

      {
        video && (
          <figure class="video">
            <video
              src={`${base}${video}`}
              poster={poster ? `${base}${poster}` : undefined}
              controls
              preload="metadata"
              playsinline
            />
            {
              (videoNote || videoCredit) && (
                <figcaption>
                  {videoNote && <p>{videoNote}</p>}
                  {videoCredit && <p class="credit" set:html={videoCredit} />}
                </figcaption>
              )
            }
          </figure>
        )
      }

      <div class="prose">
        <Content />
      </div>
    </article>
  </main>
  <Footer />
  <MobileBar />
</Layout>

<style>
  .guide-page {
    min-height: 100svh;
    padding: calc(var(--header-h) + 32px + env(safe-area-inset-top)) 0 64px;
  }

  .guide-inner {
    width: 100%;
    max-width: 44rem;
    margin: 0 auto;
    padding: 0 20px;
  }

  .back {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    margin-bottom: 20px;
    font-family: var(--head);
    font-weight: 700;
    color: var(--ink-soft);
    transition: color var(--motion) var(--ease);
  }

  .back::before {
    content: "→";
    margin-inline-end: 8px;
  }

  .back:hover {
    color: var(--accent);
  }

  .head {
    padding-bottom: 28px;
    margin-bottom: 32px;
    border-bottom: var(--line);
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    margin-bottom: 14px;
    color: var(--ink-soft);
    font-size: 0.9rem;
    font-weight: 500;
  }

  /* name and date stay together when the line wraps on a phone */
  .byline {
    display: inline-flex;
    gap: 8px;
    white-space: nowrap;
  }

  .tag {
    background: var(--ink);
    color: var(--paper);
    font-size: 0.82rem;
    font-weight: 600;
    padding: 3px 14px;
    border-radius: 999px;
  }

  .tag.draft {
    background: var(--accent);
    color: #fff;
  }

  h1 {
    font-size: clamp(2.1rem, 9vw, 3.4rem);
    margin-bottom: 12px;
  }

  .lead {
    color: var(--ink-soft);
    font-size: 1.15rem;
    max-width: 40ch;
  }

  .video {
    margin-bottom: 40px;
  }

  .video video {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    background: var(--ink);
    border: var(--line);
    border-radius: var(--radius);
    box-shadow: 7px 7px 0 rgba(255, 75, 38, 0.85);
  }

  .video figcaption {
    margin-top: 16px;
    color: var(--ink-soft);
    font-size: 0.95rem;
  }

  .video .credit {
    margin-top: 6px;
    font-size: 0.85rem;
  }

  .video .credit :global(a) {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* Markdown content is not scoped, so everything below goes through :global. */
  .prose {
    font-size: 1.09rem;
    line-height: 1.8;
    overflow-wrap: break-word;
  }

  .prose :global(> * + *) {
    margin-top: 1.1em;
  }

  .prose :global(h2) {
    font-size: clamp(1.6rem, 6.5vw, 2.1rem);
    margin-top: 2em;
    scroll-margin-top: 90px;
  }

  .prose :global(h3) {
    font-size: 1.35rem;
    margin-top: 1.7em;
    scroll-margin-top: 90px;
  }

  .prose :global(a) {
    color: var(--accent-dark);
    font-weight: 600;
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 3px;
  }

  .prose :global(a:hover) {
    color: var(--ink);
  }

  .prose :global(strong) {
    font-weight: 700;
    unicode-bidi: isolate;
  }

  .prose :global(em) {
    display: inline-block;
    font-style: normal;
    font-size: 0.93rem;
    color: var(--ink-soft);
  }

  /* Checklists: "- [ ] item" in Markdown. */
  .prose :global(ul.contains-task-list > li) {
    padding-inline-start: 0;
    display: flex;
    gap: 12px;
    align-items: baseline;
  }

  .prose :global(ul.contains-task-list > li::before) {
    content: none;
  }

  .prose :global(li.task-list-item input) {
    flex: none;
    appearance: none;
    width: 20px;
    height: 20px;
    margin: 0;
    translate: 0 3px;
    background: var(--card);
    border: var(--line);
    border-radius: 6px;
  }

  .prose :global(ul),
  .prose :global(ol) {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .prose :global(ul > li) {
    position: relative;
    padding-inline-start: 26px;
  }

  .prose :global(ul > li::before) {
    content: "";
    position: absolute;
    inset-inline-start: 4px;
    top: 0.72em;
    width: 10px;
    height: 10px;
    background: var(--accent);
    border: 2px solid var(--ink);
    border-radius: 50%;
  }

  .prose :global(ol) {
    counter-reset: step;
  }

  .prose :global(ol > li) {
    counter-increment: step;
    position: relative;
    padding-inline-start: 46px;
    min-height: 32px;
  }

  .prose :global(ol > li::before) {
    content: counter(step);
    position: absolute;
    inset-inline-start: 0;
    top: 0.1em;
    width: 32px;
    height: 32px;
    display: grid;
    place-items: center;
    font-family: var(--head);
    font-size: 1rem;
    line-height: 1;
    color: #fff;
    background: var(--accent);
    border: var(--line);
    border-radius: 10px;
  }

  .prose :global(blockquote) {
    background: var(--card);
    border: var(--line);
    border-inline-start: 8px solid var(--accent);
    border-radius: var(--radius);
    box-shadow: var(--shadow-sm);
    padding: 16px 20px;
    font-weight: 500;
  }

  .prose :global(:not(pre) > code) {
    direction: ltr;
    unicode-bidi: isolate;
    font-size: 0.9em;
    background: var(--paper-soft);
    border: 1px solid rgba(23, 20, 16, 0.25);
    border-radius: 6px;
    padding: 1px 6px;
  }

  .prose :global(pre) {
    direction: ltr;
    text-align: left;
    background: var(--ink) !important;
    border: var(--line);
    border-radius: var(--radius);
    box-shadow: var(--shadow-sm);
    padding: 18px 20px;
    font-size: 0.92rem;
    line-height: 1.6;
    overflow-x: auto;
  }

  .prose :global(img) {
    height: auto;
    border: var(--line);
    border-radius: var(--radius);
    box-shadow: var(--shadow-sm);
  }

  .prose :global(hr) {
    border: none;
    border-top: var(--line);
    margin-block: 2em;
  }

  .prose :global(table) {
    display: block;
    overflow-x: auto;
    border-collapse: collapse;
  }

  .prose :global(th),
  .prose :global(td) {
    border: 1px solid rgba(23, 20, 16, 0.3);
    padding: 8px 12px;
    text-align: start;
  }

  @media (min-width: 768px) {
    .guide-page {
      padding-top: calc(var(--header-h) + 48px);
      padding-bottom: 96px;
    }

    .guide-inner {
      padding: 0 32px;
    }
  }
</style>
