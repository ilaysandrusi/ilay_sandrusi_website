---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import SceneOpen from "../components/SceneOpen.astro";
import SceneChoose from "../components/SceneChoose.astro";
import ScenePlans from "../components/ScenePlans.astro";
import SceneAbout from "../components/SceneAbout.astro";
import Footer from "../components/Footer.astro";
import MobileBar from "../components/MobileBar.astro";
---

<Layout
  title="איליי סנדרוסי · בניית אתרים"
  description="אתרי איקומרס ודפי נחיתה לעסקים — במיוחד למי שמתחיל. עיצוב מותאם, מחיר הוגן ובדיקות לפני השקה."
>
  <Header />
  <main>
    <SceneOpen />
    <SceneChoose />
    <ScenePlans />
    <SceneAbout />
  </main>
  <Footer />
  <MobileBar />
</Layout>
