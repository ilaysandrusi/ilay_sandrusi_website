---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Services from "../components/Services.astro";
import Packages from "../components/Packages.astro";
import Process from "../components/Process.astro";
import WhyMe from "../components/WhyMe.astro";
import Faq from "../components/Faq.astro";
import Contact from "../components/Contact.astro";
import Footer from "../components/Footer.astro";
import MobileBar from "../components/MobileBar.astro";
---

<Layout
  title="איליי סנדרוסי · בניית אתרים לעסקים"
  description="אתרי איקומרס ודפי נחיתה עם עיצוב ייחודי, השקעה מהלב, אמינות ומחירים הוגנים. כולל בדיקות תוכנה לפני השקה."
>
  <Header />
  <main>
    <Hero />
    <Services />
    <Packages />
    <Process />
    <WhyMe />
    <Faq />
    <Contact />
  </main>
  <Footer />
  <MobileBar />
</Layout>
