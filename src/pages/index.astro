---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import SceneOpen from "../components/SceneOpen.astro";
import SceneChoose from "../components/SceneChoose.astro";
import ScenePlans from "../components/ScenePlans.astro";
import SceneAbout from "../components/SceneAbout.astro";
import Footer from "../components/Footer.astro";
import MobileBar from "../components/MobileBar.astro";

const scenes = [
  { href: "#top", label: "פתיחה" },
  { href: "#about", label: "עליי" },
  { href: "#choose", label: "בחירה" },
  { href: "#plans", label: "מסלולים" },
];
---

<Layout
  title="איליי סנדרוסי · בניית אתרים"
  description="איליי סנדרוסי. אתרי איקומרס ודפי נחיתה לעסקים שמתחילים. עיצוב, מחיר ברור, ובדיקות לפני השקה."
>
  <Header />
  <nav class="scene-nav" aria-label="ניווט בין סצנות">
    {
      scenes.map((s) => (
        <a href={s.href} aria-label={s.label} aria-current="false" title={s.label} />
      ))
    }
  </nav>
  <main id="main">
    <SceneOpen />
    <SceneAbout />
    <SceneChoose />
    <ScenePlans />
  </main>
  <Footer />
  <MobileBar />
</Layout>
