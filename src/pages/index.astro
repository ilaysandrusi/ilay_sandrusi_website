---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import SceneOpen from "../components/SceneOpen.astro";
import SceneChoose from "../components/SceneChoose.astro";
import ScenePlans from "../components/ScenePlans.astro";
import SceneAbout from "../components/SceneAbout.astro";
import SceneWork from "../components/SceneWork.astro";
import SceneContact from "../components/SceneContact.astro";
import Footer from "../components/Footer.astro";
import MobileBar from "../components/MobileBar.astro";
import RopeClimber from "../components/RopeClimber.astro";
import { siteDescription } from "../data/contact";
import { siteName } from "../data/site";
---

<Layout
  title={`${siteName} · אתרים, דפי נחיתה וחנויות אונליין לעסקים`}
  description={siteDescription}
>
  <Header />
  <main id="main">
    <SceneOpen />
    <SceneWork />
    <SceneAbout />
    <SceneChoose />
    <ScenePlans />
    <SceneContact />
  </main>
  <Footer />
  <MobileBar />
  <RopeClimber />
</Layout>
