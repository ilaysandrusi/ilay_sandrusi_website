---
import { instagramLink } from "../data/contact";
import { sections } from "../data/nav";
import { base, homePrefix, siteName } from "../data/site";

const year = new Date().getFullYear();
const home = homePrefix(Astro.url.pathname);
---

<footer>
  <div class="container footer-inner">
    <p>© {year} {siteName}</p>
    <nav>
      {sections.map((s) => <a href={`${home}#${s.id}`}>{s.label}</a>)}
      <a href={`${base}blog/`}>בלוג</a>
      <a href={instagramLink} target="_blank" rel="noopener noreferrer">אינסטגרם</a>
    </nav>
  </div>
</footer>

<style>
  footer {
    border-top: var(--line);
    padding: 28px 0;
  }

  .footer-inner {
    display: flex;
    flex-direction: column;
    gap: 14px;
    color: var(--ink-soft);
    font-size: 0.95rem;
    text-align: center;
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 24px;
    justify-content: center;
    font-family: var(--head);
    font-weight: 600;
  }

  nav a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }

  nav a:hover {
    color: var(--ink);
  }

  @media (min-width: 820px) {
    .footer-inner {
      flex-direction: row;
      justify-content: space-between;
      text-align: start;
    }
  }
</style>
