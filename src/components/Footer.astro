---
const year = new Date().getFullYear();
const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith("/") ? rawBase : `${rawBase}/`;
const path = Astro.url.pathname.endsWith("/") ? Astro.url.pathname : `${Astro.url.pathname}/`;
const home = path === base ? "" : base;
---

<footer>
  <div class="container footer-inner">
    <p>© {year} איליי סנדרוסי</p>
    <nav>
      <a href={`${home}#about`}>עליי</a>
      <a href={`${home}#work`}>פרויקטים</a>
      <a href={`${home}#choose`}>בחירה</a>
      <a href={`${home}#plans`}>מסלולים</a>
      <a href={`${base}guides/`}>מדריכים</a>
      <a href={`${home}#contact`}>פרטים</a>
    </nav>
  </div>
</footer>

<style>
  footer {
    border-top: var(--line);
    padding: 28px 0;
  }

  .footer-inner {
    display: flex;
    flex-direction: column;
    gap: 14px;
    color: var(--ink-soft);
    font-size: 0.95rem;
    text-align: center;
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 24px;
    justify-content: center;
    font-weight: 600;
  }

  nav a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }

  nav a:hover {
    color: var(--ink);
  }

  @media (min-width: 820px) {
    .footer-inner {
      flex-direction: row;
      justify-content: space-between;
      text-align: start;
    }
  }
</style>
