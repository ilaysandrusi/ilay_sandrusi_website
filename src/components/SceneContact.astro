---
import { email } from "../data/contact";

const formAction = `https://formsubmit.co/${email}`;
---

<section class="scene contact" id="contact">
  <div class="contact-inner">
    <p class="eyebrow contact-eye">פרטים</p>
    <h2>מעדיפים שאני אחזור אליכם?</h2>
    <p class="lead">השאירו שם וטלפון. אחזור אליכם.</p>

    <form class="form" id="contact-form" action={formAction} method="POST" novalidate>
      <input type="hidden" name="_subject" value="פנייה מהאתר של איליי" />
      <input type="hidden" name="_template" value="table" />
      <input type="hidden" name="_captcha" value="false" />
      <input type="text" name="_honey" class="honey" tabindex="-1" autocomplete="off" aria-hidden="true" />

      <div class="field">
        <label for="contact-name">שם <span class="req" aria-hidden="true">*</span></label>
        <input id="contact-name" name="name" type="text" autocomplete="name" required aria-required="true" />
      </div>

      <div class="field">
        <label for="contact-phone">טלפון <span class="req" aria-hidden="true">*</span></label>
        <input
          id="contact-phone"
          name="phone"
          type="tel"
          inputmode="tel"
          autocomplete="tel"
          dir="ltr"
          required
          aria-required="true"
        />
      </div>

      <div class="field">
        <label for="contact-email">מייל <span class="opt">(לא חובה)</span></label>
        <input
          id="contact-email"
          name="email"
          type="email"
          autocomplete="email"
          dir="ltr"
        />
      </div>

      <div class="field">
        <label for="contact-message">במה אפשר לעזור <span class="opt">(לא חובה)</span></label>
        <textarea id="contact-message" name="message" rows="4"></textarea>
      </div>

      <p class="form-status" id="contact-status" aria-live="polite"></p>

      <button class="btn btn-primary submit" type="submit">שלחו פרטים</button>
    </form>
  </div>
</section>

<script>
  const form = document.getElementById("contact-form") as HTMLFormElement | null;
  const status = document.getElementById("contact-status");
  const submit = form?.querySelector<HTMLButtonElement>('button[type="submit"]');

  const setStatus = (text: string, kind: "ok" | "err" | "") => {
    if (!status) return;
    status.textContent = text;
    status.classList.toggle("ok", kind === "ok");
    status.classList.toggle("err", kind === "err");
  };

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (!form.checkValidity()) {
      form.reportValidity();
      setStatus("חסר שם או טלפון.", "err");
      return;
    }

    const honey = (form.querySelector('[name="_honey"]') as HTMLInputElement | null)?.value;
    if (honey) return;

    const data = new FormData(form);
    const payload: Record<string, string> = {};
    data.forEach((value, key) => {
      if (key === "_honey") return;
      payload[key] = String(value);
    });

    if (submit) {
      submit.disabled = true;
      submit.textContent = "שולח…";
    }
    setStatus("", "");

    try {
      const res = await fetch(form.action.replace("formsubmit.co/", "formsubmit.co/ajax/"), {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          Accept: "application/json",
        },
        body: JSON.stringify(payload),
      });
      if (!res.ok) throw new Error("send failed");
      form.reset();
      setStatus("קיבלתי. אחזור אליכם.", "ok");
    } catch {
      setStatus("לא הצלחתי לשלוח. נסו שוב, או כתבו לי בוואטסאפ.", "err");
    } finally {
      if (submit) {
        submit.disabled = false;
        submit.textContent = "שלחו פרטים";
      }
    }
  });
</script>

<style>
  .scene.contact {
    min-height: 100svh;
    display: flex;
    align-items: center;
    background: var(--ink);
    color: var(--paper);
    padding: 90px 0 calc(var(--bar-height) + 40px);
    border-top: var(--line);
  }

  .contact-inner {
    width: 100%;
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 20px;
  }

  .contact-eye {
    background: var(--accent);
    color: #fff;
  }

  h2 {
    font-size: clamp(2.2rem, 9vw, 3.6rem);
    margin-bottom: 10px;
    max-width: 14ch;
  }

  .lead {
    color: #d2cbc0;
    font-size: 1.08rem;
    margin-bottom: 32px;
    max-width: 34ch;
  }

  .form {
    display: flex;
    flex-direction: column;
    gap: 16px;
    max-width: 32rem;
  }

  .honey {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  label {
    font-weight: 700;
    font-size: 0.95rem;
  }

  .opt {
    font-weight: 500;
    color: #cfc6b8;
  }

  .req {
    color: var(--accent);
    font-weight: 700;
  }

  input,
  textarea {
    width: 100%;
    min-height: 52px;
    padding: 12px 14px;
    border: var(--line);
    border-radius: 14px;
    background: var(--card);
    color: var(--ink);
    font-family: inherit;
    font-size: 1.02rem;
  }

  textarea {
    min-height: 120px;
    resize: vertical;
  }

  input:focus-visible,
  textarea:focus-visible {
    outline: 3px solid var(--accent);
    outline-offset: 3px;
  }

  .submit {
    width: 100%;
    max-width: 320px;
    margin-top: 8px;
  }

  .submit:disabled {
    opacity: 0.7;
    cursor: wait;
  }

  .form-status {
    min-height: 1.4em;
    font-weight: 700;
  }

  .form-status.ok {
    color: #8ee0a8;
  }

  .form-status.err {
    color: #ffb4a2;
  }

  @media (min-width: 768px) {
    .contact-inner {
      padding: 0 32px;
    }

    .submit {
      width: auto;
    }
  }
</style>
