---
import { whatsappLink } from "../data/contact";

const plans = [
  {
    num: "01",
    name: "אתר עד שאתם מרוצים",
    tag: "מסלול בסיסי",
    outcome: "אתר מוכן להשקה, בלי לעצור באמצע.",
    text: "בונים עד שזה מרגיש נכון. אני בודק, ואז משחרר לאוויר.",
    items: ["אפיון ועיצוב", "בנייה עד שאתם מרוצים", "בדיקות תוכנה", "השקה"],
    fit: "ecommerce landing",
    wa: "היי איליי, מעניין אותי מסלול 1, אתר עד שאתם מרוצים",
  },
  {
    num: "02",
    name: "אתר + תחזוקה חודשית",
    tag: "עם ליווי",
    outcome: "האתר חי, ואני נשאר איתו אחרי ההשקה.",
    text: "מסלול 1, ועוד ליווי חודשי: בדיקות, עדכוני גרסה ותיקונים קטנים.",
    items: ["הכול ממסלול 1", "בדיקות חודשיות", "עדכוני גרסה", "תיקונים קטנים"],
    fit: "ecommerce landing",
    wa: "היי איליי, מעניין אותי מסלול 2, אתר + תחזוקה חודשית",
  },
  {
    num: "03",
    name: "אתר + תחזוקה + אוטומציות",
    tag: "מסלול מלא",
    outcome: "אתר עם חיבורים שעובדים ברקע.",
    text: "מסלול 2, ועוד חיבורים לטפסים, וואטסאפ ומערכות.",
    items: ["הכול ממסלול 2", "אוטומציות וחיבורים", "טפסים והתראות", "תחזוקה שוטפת"],
    fit: "ecommerce",
    wa: "היי איליי, מעניין אותי מסלול 3, אתר + תחזוקה + אוטומציות",
  },
  {
    num: "04",
    name: "נתאים יחד",
    tag: "מסלול אישי",
    outcome: "רק מה שאתם צריכים, לפי היקף ותקציב.",
    text: "נשב, נבין מה צריך, ונבנה מסלול משלכם.",
    items: ["שיחת היכרות", "התאמה להיקף ולתקציב", "רק מה שצריך"],
    fit: "unique",
    featured: true,
    wa: "היי איליי, לא מצאתי מסלול שמתאים. רוצה לבנות משהו משלנו.",
  },
];
---

<section class="scene plans" id="plans" data-filter="">
  <div class="plans-head">
    <p class="eyebrow">מסלולים</p>
    <h2>בחרו מסלול והמשיכו בוואטסאפ</h2>
    <p class="lead">אחרי הבחירה למעלה נפתחים רק המסלולים שמתאימים. השאר נשארים נעולים.</p>
    <p class="note">המחיר נקבע בשיחה. בדרך כלל פרויקט אחד בכל פעם.</p>
  </div>

  <div class="rail" tabindex="0" aria-label="כרטיסי מסלולים">
    {
      plans.map((p) => (
        <article
          class:list={["plan", "card", { featured: p.featured }]}
          data-fit={p.fit}
        >
          <span class="lock-badge">לא מתאים לבחירה שלכם</span>
          <span class="num" aria-hidden="true">{p.num}</span>
          <span class="tag">{p.tag}</span>
          <h3>{p.name}</h3>
          <p class="outcome">{p.outcome}</p>
          <p>{p.text}</p>
          <ul>
            {p.items.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
          <a
            class={p.featured ? "btn btn-primary" : "btn btn-ghost"}
            href={`${whatsappLink}?text=${encodeURIComponent(p.wa)}`}
            target="_blank"
            rel="noopener noreferrer"
          >
            {p.featured ? "דברו איתי על מסלול אישי" : `דברו איתי על מסלול ${p.num}`}
          </a>
          <p class="locked-hint">בחרו כיוון אחר למעלה כדי לפתוח את המסלול הזה</p>
        </article>
      ))
    }
  </div>
</section>

<style>
  .scene.plans {
    padding: 72px 0 calc(var(--bar-height) + 40px);
  }

  .plans-head {
    max-width: var(--max-width);
    margin: 0 auto 28px;
    padding: 0 20px;
  }

  h2 {
    font-size: clamp(2rem, 8vw, 3.2rem);
    margin-bottom: 8px;
  }

  .lead {
    color: var(--ink-soft);
  }

  .note {
    margin-top: 10px;
    color: var(--ink-soft);
    font-size: 0.98rem;
    max-width: 42ch;
  }

  .outcome {
    font-weight: 600;
    color: var(--ink);
    font-size: 1.02rem;
  }

  /* Horizontal cinematic rail on mobile; grid on desktop */
  .rail {
    display: flex;
    gap: 16px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding: 8px 20px 24px;
    -webkit-overflow-scrolling: touch;
    overscroll-behavior-x: contain;
    scrollbar-width: none;
  }

  .rail::-webkit-scrollbar {
    display: none;
  }

  .plan {
    flex: 0 0 min(86vw, 340px);
    scroll-snap-align: center;
    padding: 26px 22px 28px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    position: relative;
    transition: opacity 0.25s ease, transform 0.25s ease, filter 0.25s ease;
  }

  .lock-badge {
    display: none;
    position: absolute;
    top: 14px;
    inset-inline-end: 14px;
    background: var(--ink);
    color: var(--paper);
    font-size: 0.78rem;
    font-weight: 700;
    padding: 4px 10px;
    border-radius: 999px;
    border: var(--line);
    z-index: 2;
  }

  .plan.featured .lock-badge {
    background: var(--accent);
    color: #fff;
  }

  .plan.locked {
    opacity: 0.4;
    filter: grayscale(0.55);
    transform: scale(0.98);
  }

  .plan.locked .lock-badge {
    display: inline-block;
  }

  .plan.locked .btn,
  .plan .btn.is-disabled {
    pointer-events: none;
    cursor: not-allowed;
    opacity: 0.55;
  }

  .plan.spotlight {
    opacity: 1;
    filter: none;
    transform: scale(1.02);
  }

  .plan.featured {
    background: var(--ink);
    color: var(--paper);
  }

  .num {
    font-family: "Suez One", serif;
    width: 44px;
    height: 44px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--ink);
    color: #fff;
  }

  .featured .num {
    background: var(--accent);
  }

  .tag {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--accent);
  }

  h3 {
    font-size: 1.4rem;
  }

  .plan > p {
    color: var(--ink-soft);
    font-size: 0.98rem;
  }

  .featured > p {
    color: #cfc6b8;
  }

  ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin: 4px 0 8px;
  }

  li {
    position: relative;
    padding-inline-start: 20px;
    font-weight: 600;
    font-size: 0.92rem;
  }

  li::before {
    content: "";
    position: absolute;
    inset-inline-start: 0;
    top: 0.45em;
    width: 8px;
    height: 8px;
    background: var(--accent);
    border: 1.5px solid currentColor;
    border-radius: 2px;
  }

  .plan .btn {
    margin-top: auto;
    width: 100%;
  }

  .locked-hint {
    display: none;
    margin-top: 8px;
    font-size: 0.85rem;
    color: var(--ink-soft);
    font-weight: 600;
  }

  .plan.locked .locked-hint {
    display: block;
  }

  .plan.featured .locked-hint {
    color: #cfc6b8;
  }

  @media (min-width: 900px) {
    .plans-head {
      padding: 0 32px;
    }

    .rail {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 22px;
      overflow: visible;
      max-width: var(--max-width);
      margin: 0 auto;
      padding: 8px 32px 0;
    }

    .plan {
      flex: none;
      min-height: 380px;
    }
  }
</style>
