---
import "@fontsource/bungee/latin-400.css"; // the big plan numbers only (digits, Latin file)
import { whatsappLink } from "../data/contact";
// the plans and the choices that open them are listed in src/data/plans.ts
import { planButtonText, planNumber, plans, planWhatsappText } from "../data/plans";
---

<section class="scene plans has-deco" id="plans" data-filter="">
  <span class="deco orange drift-a" aria-hidden="true" style="width:170px;height:170px;right:-70px;bottom:70px;transform:rotate(24deg)"></span>
  <div class="container plans-head">
    <h2 class="scene-title">בחרו מסלול והמשיכו בוואטסאפ</h2>
    <p class="lead">אחרי הבחירה למעלה נפתחים רק המסלולים שמתאימים. השאר נשארים נעולים.</p>
    <p class="note">המחיר נקבע בשיחה. בדרך כלל פרויקט אחד בכל פעם.</p>
  </div>

  <div class="rail" tabindex="0" aria-label="כרטיסי מסלולים">
    {
      plans.map((p) => (
        <article
          class:list={["plan", "card", { featured: p.featured }]}
          data-fit={p.fit.join(" ")}
        >
          <span class="lock-badge">לא מתאים לבחירה שלכם</span>
          <span class="num" aria-hidden="true">{planNumber(p)}</span>
          <span class="tag">{p.tag}</span>
          <h3>{p.name}</h3>
          <p class="outcome">{p.outcome}</p>
          <p>{p.text}</p>
          <ul>
            {p.items.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
          <a
            class={p.featured ? "btn btn-primary" : "btn btn-ghost"}
            href={`${whatsappLink}?text=${encodeURIComponent(planWhatsappText(p))}`}
            target="_blank"
            rel="noopener noreferrer"
          >
            {planButtonText(p)}
          </a>
          <p class="locked-hint">בחרו כיוון אחר למעלה כדי לפתוח את המסלול הזה</p>
        </article>
      ))
    }
  </div>
</section>

<style>
  .scene.plans {
    padding: var(--sp-section) 0;
  }

  .plans-head {
    margin-bottom: 28px;
  }

  .lead {
    color: var(--ink-soft);
  }

  .note {
    margin-top: 10px;
    color: var(--ink-soft);
    font-size: 0.98rem;
    max-width: 42ch;
  }

  .outcome {
    font-family: var(--head);
    font-weight: 600;
    color: var(--ink);
    font-size: 1.02rem;
  }

  /* Horizontal cinematic rail on mobile; grid on desktop */
  .rail {
    display: flex;
    gap: 16px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding: 8px 20px 24px;
    -webkit-overflow-scrolling: touch;
    overscroll-behavior-x: contain;
    scrollbar-width: none;
  }

  .rail::-webkit-scrollbar {
    display: none;
  }

  .plan {
    flex: 0 0 min(86vw, 340px);
    scroll-snap-align: center;
    padding: 26px 22px 28px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    position: relative;
    transition: opacity 0.25s ease, transform 0.25s ease, filter 0.25s ease, box-shadow 0.25s ease;
  }

  .lock-badge {
    display: none;
    position: absolute;
    top: 14px;
    inset-inline-end: 14px;
    background: var(--ink);
    color: var(--paper);
    font-family: var(--head);
    font-size: 0.78rem;
    font-weight: 700;
    padding: 4px 10px;
    border-radius: 999px;
    border: var(--line);
    z-index: 2;
  }

  .plan.featured .lock-badge {
    background: var(--accent);
    color: #fff;
  }

  .plan.locked {
    opacity: 0.4;
    filter: grayscale(0.55);
    transform: scale(0.98);
  }

  .plan.locked .lock-badge {
    display: inline-block;
  }

  .plan.locked .btn,
  .plan .btn.is-disabled {
    pointer-events: none;
    cursor: not-allowed;
    opacity: 0.55;
  }

  .plan.spotlight {
    opacity: 1;
    filter: none;
    transform: scale(1.02);
  }

  .plan.featured {
    background: var(--ink);
    color: var(--paper);
  }

  /* the big plan number, in Bungee like a street sign */
  .num {
    font-family: "Bungee", var(--head);
    font-weight: 400;
    font-size: 52px;
    line-height: 1.1;
    color: var(--ink);
  }

  .featured .num {
    color: var(--accent);
  }

  .plan:not(.locked):hover {
    transform: translate(-4px, -4px);
    box-shadow: var(--shadow-hot);
  }

  .tag {
    font-family: var(--head);
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--accent);
  }

  h3 {
    font-size: 24px;
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  .plan > p {
    color: var(--ink-soft);
    font-size: 0.98rem;
  }

  .featured > p {
    color: var(--on-ink-soft);
  }

  ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin: 4px 0 8px;
  }

  li {
    position: relative;
    padding-inline-start: 20px;
    font-family: var(--head);
    font-weight: 600;
    font-size: 0.92rem;
  }

  li::before {
    content: "";
    position: absolute;
    inset-inline-start: 0;
    top: 0.45em;
    width: 8px;
    height: 8px;
    background: var(--accent);
    border: 1.5px solid currentColor;
    border-radius: 2px;
  }

  .plan .btn {
    margin-top: auto;
    width: 100%;
  }

  .locked-hint {
    display: none;
    margin-top: 8px;
    font-family: var(--head);
    font-size: 0.85rem;
    color: var(--ink-soft);
    font-weight: 600;
  }

  .plan.locked .locked-hint {
    display: block;
  }

  .plan.featured .locked-hint {
    color: var(--on-ink-soft);
  }

  @media (prefers-reduced-motion: reduce) {
    .plan {
      transition: none;
    }

    .plan.locked {
      transform: none;
    }
  }

  /* same side margin as the heading above (the .container padding) */
  @media (min-width: 768px) {
    .rail {
      padding-inline: 32px;
    }
  }

  @media (min-width: 900px) {
    .rail {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 22px;
      overflow: visible;
      max-width: var(--max-width);
      margin: 0 auto;
      padding: 8px 32px 0;
    }

    .plan {
      flex: none;
      min-height: 380px;
    }
  }

  @media (min-width: 1100px) {
    .rail {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>
