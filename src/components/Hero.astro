---
const marqueeItems = [
  "אתרי איקומרס",
  "דפי נחיתה",
  "עיצובים ייחודיים",
  "השקעה מהלב",
  "אמינות",
  "מחירים הוגנים",
];
---

<section class="hero" id="top">
  <div class="container hero-inner">
    <div class="hero-content">
      <h1>
        בונים אתר<br />
        <em>שמתאים לעסק שלכם.</em>
      </h1>
      <p>
        היי, אני איליי. בונה אתרי איקומרס ודפי נחיתה לעסקים —
        בעיצוב ייחודי, במחיר הוגן, ועם בדיקות לפני שעולים לאוויר.
      </p>
      <div class="hero-actions">
        <a href="#contact" class="btn btn-primary">בואו נדבר</a>
        <a href="#plans" class="btn btn-ghost">המסלולים</a>
      </div>
    </div>

    <div class="hero-visual" aria-hidden="true">
      <div class="phone">
        <div class="phone-notch"></div>
        <div class="phone-screen">
          <div class="mini-nav">
            <span class="mini-logo"></span>
            <span class="mini-burger"></span>
          </div>
          <div class="mini-hero">
            <div class="mini-line w-80"></div>
            <div class="mini-line w-55"></div>
            <div class="mini-cta"></div>
          </div>
          <div class="mini-cards">
            <div class="mini-card"></div>
            <div class="mini-card"></div>
          </div>
          <div class="mini-bar">
            <span></span><span></span>
          </div>
        </div>
      </div>
      <div class="sticker">בודקים<br />לפני עלייה ✦</div>
    </div>
  </div>

  <div class="marquee" dir="ltr">
    <div class="marquee-track">
      {
        [...Array(3)].map(() => (
          <span class="marquee-group" dir="rtl">
            {marqueeItems.map((item) => (
              <span class="marquee-item">{item} ✦</span>
            ))}
          </span>
        ))
      }
    </div>
  </div>
</section>

<style>
  .hero {
    padding: 108px 0 0;
    overflow: hidden;
  }

  .hero-inner {
    display: flex;
    flex-direction: column;
    gap: 44px;
  }

  h1 {
    font-size: clamp(2.6rem, 11vw, 4.6rem);
    margin-bottom: 18px;
  }

  h1 em {
    font-style: normal;
    color: var(--accent);
    position: relative;
  }

  .hero-content p {
    font-size: 1.1rem;
    color: var(--ink-soft);
    max-width: 520px;
    margin-bottom: 28px;
  }

  .hero-actions {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  /* CSS phone mockup */
  .hero-visual {
    position: relative;
    display: flex;
    justify-content: center;
    padding-bottom: 56px;
  }

  .phone {
    width: min(270px, 72vw);
    background: var(--ink);
    border-radius: 36px;
    padding: 10px;
    box-shadow: 8px 8px 0 rgba(23, 20, 16, 0.25);
    transform: rotate(-3deg);
    position: relative;
  }

  .phone-notch {
    position: absolute;
    top: 18px;
    left: 50%;
    transform: translateX(-50%);
    width: 84px;
    height: 20px;
    background: var(--ink);
    border-radius: 999px;
    z-index: 2;
  }

  .phone-screen {
    background: var(--paper);
    border-radius: 28px;
    padding: 46px 16px 16px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    min-height: 420px;
  }

  .mini-nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .mini-logo {
    width: 44px;
    height: 10px;
    background: var(--ink);
    border-radius: 4px;
  }

  .mini-burger {
    width: 22px;
    height: 10px;
    border-top: 3px solid var(--ink);
    border-bottom: 3px solid var(--ink);
  }

  .mini-hero {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 10px 0 6px;
  }

  .mini-line {
    height: 16px;
    border-radius: 5px;
    background: var(--ink);
  }

  .w-80 { width: 80%; }
  .w-55 { width: 55%; background: var(--accent); }

  .mini-cta {
    width: 110px;
    height: 34px;
    border-radius: 10px;
    background: var(--accent);
    margin-top: 6px;
  }

  .mini-cards {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
    flex: 1;
  }

  .mini-card {
    border: 2px solid var(--ink);
    border-radius: 12px;
    background: var(--card);
    min-height: 84px;
  }

  .mini-bar {
    display: flex;
    gap: 8px;
  }

  .mini-bar span {
    flex: 1;
    height: 34px;
    border-radius: 10px;
    border: 2px solid var(--ink);
  }

  .mini-bar span:first-child {
    background: var(--accent);
    border-color: var(--accent);
  }

  .sticker {
    position: absolute;
    bottom: 30px;
    inset-inline-end: max(4vw, 12px);
    background: var(--accent);
    color: #fff;
    font-weight: 700;
    font-size: 0.9rem;
    line-height: 1.35;
    padding: 14px 18px;
    border-radius: 999px;
    border: var(--line);
    box-shadow: var(--shadow-sm);
    transform: rotate(6deg);
    text-align: center;
  }

  /* Marquee strip */
  .marquee {
    background: var(--ink);
    color: var(--paper);
    padding: 12px 0;
    transform: rotate(-1.2deg) scale(1.02);
    overflow: hidden;
    margin-top: 8px;
  }

  .marquee-track {
    display: flex;
    width: max-content;
    animation: scroll 28s linear infinite;
  }

  .marquee-group {
    display: flex;
    white-space: nowrap;
  }

  .marquee-item {
    font-family: "Suez One", serif;
    font-size: 1.05rem;
    padding: 0 14px;
  }

  @keyframes scroll {
    from { transform: translateX(0); }
    to { transform: translateX(-33.333%); }
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation: none;
    }
  }

  @media (min-width: 820px) {
    .hero {
      padding-top: 170px;
    }

    .hero-inner {
      flex-direction: row;
      align-items: center;
      gap: 40px;
    }

    .hero-content {
      flex: 1.15;
    }

    .hero-visual {
      flex: 0.85;
      padding-bottom: 0;
    }

    .hero-actions {
      flex-direction: row;
    }

    h1 {
      font-size: clamp(3.2rem, 5.5vw, 4.6rem);
    }

    .marquee {
      margin-top: 60px;
    }

    .marquee-item {
      font-size: 1.25rem;
    }

    .sticker {
      bottom: 10px;
    }
  }
</style>
