---
// TODO: replace with real contact details.
const phone = "050-0000000";
const whatsappLink = "https://wa.me/972500000000";
const email = "hello@example.com";
---

<section id="contact" class="contact">
  <div class="container">
    <div class="contact-card reveal">
      <span class="eyebrow">יצירת קשר</span>
      <h2 class="section-title">יש לכם פרויקט בראש?<br />בואו נדבר</h2>
      <p>
        השאירו הודעה בוואטסאפ או במייל ואחזור אליכם עוד היום עם כיוון ראשוני
        והצעת מחיר. השיחה הראשונה — תמיד בחינם וללא התחייבות.
      </p>
      <div class="actions">
        <a href={whatsappLink} class="btn btn-primary" target="_blank" rel="noopener">
          שלחו הודעה בוואטסאפ
        </a>
        <a href={`mailto:${email}`} class="btn btn-ghost">שלחו מייל</a>
      </div>
      <ul class="details">
        <li>
          <span class="label">טלפון</span>
          <a href={`tel:${phone.replace(/-/g, "")}`} dir="ltr">{phone}</a>
        </li>
        <li>
          <span class="label">מייל</span>
          <a href={`mailto:${email}`} dir="ltr">{email}</a>
        </li>
      </ul>
    </div>
  </div>
</section>

<style>
  .contact-card {
    background: var(--card);
    border: var(--line);
    border-radius: 24px;
    box-shadow: var(--shadow);
    padding: 44px 24px;
    text-align: center;
  }

  .section-title {
    margin-bottom: 14px;
  }

  .contact-card p {
    color: var(--ink-soft);
    font-size: 1.05rem;
    max-width: 480px;
    margin: 0 auto 28px;
  }

  .actions {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-bottom: 36px;
  }

  .details {
    list-style: none;
    display: flex;
    gap: 40px;
    justify-content: center;
    flex-wrap: wrap;
  }

  .details li {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .label {
    color: var(--ink-soft);
    font-size: 0.88rem;
  }

  .details a {
    font-weight: 700;
  }

  .details a:hover {
    color: var(--accent);
  }

  @media (min-width: 820px) {
    .contact-card {
      padding: 64px 48px;
      max-width: 760px;
      margin: 0 auto;
    }

    .actions {
      flex-direction: row;
      justify-content: center;
    }
  }
</style>
