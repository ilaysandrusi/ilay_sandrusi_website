---
const reasons = [
  {
    title: "עין של מעצב",
    text: "לפני שעיצבתי אתרים עיצבתי אופנה. העין העיצובית שפיתחתי שם — פרופורציות, צבע, פרטים קטנים — נכנסת לכל פיקסל באתר שלכם.",
  },
  {
    title: "השקעה מהלב",
    text: "אני לא מייצר אתרים על סרט נע. כל פרויקט מקבל תשומת לב אמיתית, עד שזה מרגיש נכון — לכם וללקוחות שלכם.",
  },
  {
    title: "אמינות שנבדקת",
    text: "אני בודק תוכנה במקצועי, עם ניסיון במערכות. כל אתר עובר בדיקות קפדניות במכשירים ובדפדפנים — לפני שהוא עולה לאוויר.",
  },
  {
    title: "מחירים הוגנים",
    text: "הצעת מחיר סגורה וברורה מראש. בלי הפתעות, בלי אותיות קטנות, ובלי לשלם על דברים שלא ביקשתם.",
  },
];
---

<section class="why">
  <div class="container">
    <span class="eyebrow why-eyebrow">למה איתי</span>
    <h2 class="section-title">למה עסקים בוחרים בי</h2>
    <div class="grid">
      {
        reasons.map((r) => (
          <div class="reason reveal">
            <span class="check" aria-hidden="true">✓</span>
            <div>
              <h3>{r.title}</h3>
              <p>{r.text}</p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .why {
    background: var(--ink);
    color: var(--paper);
  }

  .why-eyebrow {
    background: var(--accent);
    color: #fff;
  }

  .grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 28px;
    margin-top: 12px;
  }

  .reason {
    display: flex;
    gap: 16px;
    align-items: flex-start;
  }

  .check {
    flex-shrink: 0;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--accent);
    color: #fff;
    font-weight: 700;
    font-size: 1.1rem;
  }

  h3 {
    font-size: 1.25rem;
    margin-bottom: 6px;
  }

  p {
    color: #b8b0a3;
    font-size: 0.98rem;
  }

  @media (min-width: 700px) {
    .grid {
      grid-template-columns: 1fr 1fr;
      gap: 36px;
    }
  }
</style>
