---
const reasons = [
  {
    title: "רקע מאופנה",
    text: "לפני אתרים עבדתי בעיצוב אופנה. זה נתן לי עין לפרטים, לצבע ולמראה הכללי — ואני מביא את זה גם לכאן.",
  },
  {
    title: "השקעה מהלב",
    text: "אני לוקח פרויקטים שאני יכול לתת להם תשומת לב אמיתית. לא על סרט נע.",
  },
  {
    title: "בודק תוכנה",
    text: "יש לי ניסיון בבדיקות תוכנה ובמערכות. לפני שהאתר עולה — בודקים שהכול עובד.",
  },
  {
    title: "מחירים הוגנים",
    text: "הצעת מחיר ברורה מראש. בלי הפתעות ובלי לשלם על דברים שלא ביקשתם.",
  },
];
---

<section class="why">
  <div class="container">
    <span class="eyebrow why-eyebrow">קצת עליי</span>
    <h2 class="section-title">מה חשוב לי בעבודה</h2>
    <div class="grid">
      {
        reasons.map((r) => (
          <div class="reason reveal">
            <span class="check" aria-hidden="true">✓</span>
            <div>
              <h3>{r.title}</h3>
              <p>{r.text}</p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .why {
    background: var(--ink);
    color: var(--paper);
  }

  .why-eyebrow {
    background: var(--accent);
    color: #fff;
  }

  .grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 28px;
    margin-top: 12px;
  }

  .reason {
    display: flex;
    gap: 16px;
    align-items: flex-start;
  }

  .check {
    flex-shrink: 0;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--accent);
    color: #fff;
    font-weight: 700;
    font-size: 1.1rem;
  }

  h3 {
    font-size: 1.25rem;
    margin-bottom: 6px;
  }

  p {
    color: #b8b0a3;
    font-size: 0.98rem;
  }

  @media (min-width: 700px) {
    .grid {
      grid-template-columns: 1fr 1fr;
      gap: 36px;
    }
  }
</style>
