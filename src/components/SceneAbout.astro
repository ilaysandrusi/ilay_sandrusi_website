---
const points = [
  {
    title: "בודק תוכנה",
    text: [
      "ביום־יום אני עובד כבודק תוכנה בפרויקטים ממשלתיים ומערכות מורכבות. זה אומר שאני רגיל לחפש בדיוק את הדברים שאחרים מפספסים.",
      "אז לפני שאתר שאני בונה עולה לאוויר, אני בודק אותו מכל הכיוונים — כי אתר יפה זה אחלה, אבל עדיף שגם יעבוד.",
    ],
  },
  {
    title: "עין עיצובית",
    text: "עיצוב תמיד היה חלק ממני. לפני שנכנסתי לעולם האתרים, היה לי מותג אופנה משלי וגם עיצבתי בעצמי. משם מגיעה העין שלי לפרטים, לצבעים ולדברים הקטנים שגורמים לעיצוב פשוט להרגיש נכון.",
  },
  {
    title: "עסקים מתחילים",
    text: "הייתי שם בעצמי — הקמתי עסק מאפס, למדתי, טעיתי וחקרתי לא מעט בדרך. מאז יצא לי לעבוד גם עם עסקים בתחילת הדרך, אז אני מבין את השאלות והבלגן שמגיעים בהתחלה. המטרה שלי היא לעשות לפחות את החלק של האתר פשוט וברור.",
  },
  {
    title: "אחד בכל פעם",
    text: "בניית אתרים היא לא העבודה העיקרית שלי — ביום־יום אני עובד כבודק תוכנה. בגלל זה אני לא מעמיס פרויקטים ולוקח בדרך כלל אחד בכל פעם, כדי לתת לכל עסק את הזמן ותשומת הלב שמגיעים לו.",
  },
];
---

<section class="scene about" id="about">
  <div class="about-inner">
    <p class="eyebrow about-eye">קצת עליי</p>
    <h2>מה חשוב לי שתדעו עליי</h2>
    <div class="points">
      {
        points.map((p, i) => (
          <div class="point">
            <span class="n">{String(i + 1).padStart(2, "0")}</span>
            <div>
              <h3>{p.title}</h3>
              {(Array.isArray(p.text) ? p.text : [p.text]).map((t) => (
                <p>{t}</p>
              ))}
            </div>
          </div>
        ))
      }
    </div>
    <a href="#choose" class="btn btn-primary about-cta">בחרו מה אתם צריכים</a>
  </div>
</section>

<style>
  .scene.about {
    min-height: 100svh;
    display: flex;
    align-items: center;
    background: var(--ink);
    color: var(--paper);
    padding: 90px 0 calc(var(--bar-height) + 40px);
  }

  .about-inner {
    width: 100%;
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 20px;
  }

  .about-eye {
    background: var(--accent);
    color: #fff;
  }

  h2 {
    font-size: clamp(2.2rem, 9vw, 3.6rem);
    margin-bottom: 36px;
  }

  .points {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .point {
    display: grid;
    grid-template-columns: 56px 1fr;
    gap: 14px;
    align-items: start;
    padding-bottom: 24px;
    border-bottom: 1px solid rgba(246, 241, 231, 0.18);
  }

  .point:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .n {
    font-family: "Suez One", serif;
    font-size: 1.4rem;
    color: var(--accent);
  }

  h3 {
    font-size: 1.3rem;
    margin-bottom: 6px;
  }

  .point p {
    color: #d2cbc0;
    font-size: 1rem;
    max-width: 46ch;
  }

  .point p + p {
    margin-top: 10px;
  }

  .about-cta {
    margin-top: 36px;
    width: 100%;
    max-width: 320px;
  }

  @media (min-width: 768px) {
    .about-inner {
      padding: 0 32px;
    }

    .points {
      max-width: 42rem;
      gap: 8px;
    }

    .about-cta {
      width: auto;
    }
  }
</style>
