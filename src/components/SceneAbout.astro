---
const points = [
  {
    title: "בודק תוכנה",
    text: [
      "ביום־יום אני בודק תוכנה בפרויקטים ממשלתיים ומערכות מורכבות. אני מחפש בדיוק את מה שאחרים מפספסים.",
      "לפני עלייה לאוויר אני בודק טפסים, קישורים ומסכים שונים.",
    ],
  },
  {
    title: "עין עיצובית",
    text: "עיצוב תמיד היה חלק ממני. לפני האתרים היה לי מותג אופנה, ועיצבתי בעצמי. משם מגיעה העין לפרטים ולצבעים.",
  },
  {
    title: "עסקים מתחילים",
    text: "הייתי שם בעצמי: הקמתי עסק מאפס, למדתי, טעיתי וחקרתי בדרך. מאז עבדתי גם עם עסקים בתחילת הדרך, ואני מכיר את השאלות והבלגן של ההתחלה. באתר שלכם אני רוצה שיהיה ברור מהר.",
  },
  {
    title: "אחד בכל פעם",
    text: "בניית אתרים היא לצד העבודה שלי. לכן אני לוקח בדרך כלל פרויקט אחד בכל פעם, כדי לתת לכל עסק את הזמן שמגיע לו.",
  },
];
---

<section class="scene about" id="about">
  <div class="about-inner">
    <p class="eyebrow about-eye">קצת עליי</p>
    <h2>מה חשוב לדעת עליי</h2>
    <div class="points">
      {
        points.map((p, i) => (
          <div class="point reveal" style={`--reveal-delay: ${i * 90}ms`}>
            <span class="n">{String(i + 1).padStart(2, "0")}</span>
            <div>
              <h3>{p.title}</h3>
              {(Array.isArray(p.text) ? p.text : [p.text]).map((t) => (
                <p>{t}</p>
              ))}
            </div>
          </div>
        ))
      }
    </div>
    <a href="#choose" class="btn btn-primary about-cta reveal" style="--reveal-delay: 360ms">בחרו מה בונים</a>
  </div>
</section>

<style>
  .scene.about {
    min-height: 100svh;
    display: flex;
    align-items: center;
    background: var(--ink);
    color: var(--paper);
    padding: 90px 0 calc(var(--bar-height) + 40px);
  }

  .about-inner {
    width: 100%;
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 20px;
  }

  .about-eye {
    background: var(--accent);
    color: #fff;
  }

  h2 {
    font-size: clamp(2.2rem, 9vw, 3.6rem);
    margin-bottom: 36px;
  }

  .points {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .point {
    display: grid;
    grid-template-columns: 56px 1fr;
    gap: 14px;
    align-items: start;
    padding-bottom: 24px;
    border-bottom: 1px solid rgba(246, 241, 231, 0.18);
  }

  .point:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .n {
    font-family: "Suez One", serif;
    font-size: 1.4rem;
    color: var(--accent);
  }

  h3 {
    font-size: 1.3rem;
    margin-bottom: 6px;
  }

  .point p {
    color: #d2cbc0;
    font-size: 1rem;
    max-width: 46ch;
  }

  .point p + p {
    margin-top: 10px;
  }

  .about-cta {
    margin-top: 36px;
    width: 100%;
    max-width: 320px;
  }

  @media (min-width: 768px) {
    .about-inner {
      padding: 0 32px;
    }

    .points {
      max-width: 42rem;
      gap: 8px;
    }

    .about-cta {
      width: auto;
    }
  }
</style>
