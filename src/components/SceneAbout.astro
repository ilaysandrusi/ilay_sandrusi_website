---
const points = [
  {
    title: "בודק תוכנה",
    text: [
      "ביום־יום אני בודק תוכנה בפרויקטים ממשלתיים ומערכות מורכבות. אני מחפש בדיוק את מה שאחרים מפספסים.",
      "לפני עלייה לאוויר אני בודק טפסים, קישורים ומסכים שונים.",
    ],
  },
  {
    title: "עין עיצובית",
    text: "עיצוב תמיד היה חלק ממני. לפני האתרים היה לי מותג אופנה, ועיצבתי בעצמי. משם מגיעה העין לפרטים ולצבעים.",
  },
  {
    title: "עסקים מתחילים",
    text: "הייתי שם בעצמי: הקמתי עסק מאפס, למדתי, טעיתי וחקרתי בדרך. מאז עבדתי גם עם עסקים בתחילת הדרך, ואני מכיר את השאלות והבלגן של ההתחלה. באתר שלכם אני רוצה שיהיה ברור מהר.",
  },
  {
    title: "אחד בכל פעם",
    text: "בניית אתרים היא לצד העבודה שלי. לכן אני לוקח בדרך כלל פרויקט אחד בכל פעם, כדי לתת לכל עסק את הזמן שמגיע לו.",
  },
];
---

<section class="scene about has-deco" id="about">
  <span class="deco orange drift-a" aria-hidden="true" style="width:190px;height:190px;left:-70px;top:16%;transform:rotate(18deg)"></span>
  <span class="deco paper drift-b" aria-hidden="true" style="width:110px;height:110px;left:5%;bottom:70px"></span>
  <div class="container">
  <div class="about-inner" data-about-col>
    <h2>מה חשוב לדעת עליי</h2>
    <div class="points">
      {
        points.map((p, i) => (
          <div class="point reveal" style={`--reveal-delay: ${i * 90}ms`}>
            <span class="n">{String(i + 1).padStart(2, "0")}</span>
            <div>
              <h3>{p.title}</h3>
              {(Array.isArray(p.text) ? p.text : [p.text]).map((t) => (
                <p>{t}</p>
              ))}
            </div>
          </div>
        ))
      }
    </div>
    <a href="#choose" class="btn btn-primary about-cta reveal" style="--reveal-delay: 360ms">בחרו מה בונים</a>
  </div>
  </div>
</section>

<style>
  /* light section, after the dark projects section */
  .scene.about {
    background: var(--paper);
    color: var(--ink);
    padding: var(--sp-section) 0;
  }

  .about-inner {
    max-width: 860px;
  }

  h2 {
    font-size: clamp(38px, 5.2vw, 68px);
    line-height: 0.95;
    margin-bottom: 40px;
  }

  .points {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .points {
    gap: 0;
  }

  .point {
    display: grid;
    grid-template-columns: 64px 1fr;
    gap: 6px 18px;
    align-items: start;
    padding: 28px 0;
    border-top: 1px solid rgba(23, 20, 16, 0.14);
  }

  .point:last-child {
    border-bottom: 1px solid rgba(23, 20, 16, 0.14);
  }

  .n {
    font-family: var(--head);
    font-weight: 700;
    font-size: 34px;
    line-height: 1;
    letter-spacing: -0.04em;
    color: var(--accent-text);
  }

  h3 {
    font-size: 26px;
    letter-spacing: -0.02em;
    margin-bottom: 6px;
  }

  .point p {
    color: var(--ink-soft);
    max-width: 52ch;
  }

  .point p + p {
    margin-top: 10px;
  }

  .about-cta {
    margin-top: 40px;
    width: 100%;
    max-width: 320px;
  }

  @media (min-width: 768px) {

    .about-cta {
      width: auto;
    }
  }
</style>
