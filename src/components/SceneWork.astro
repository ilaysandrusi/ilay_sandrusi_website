---
import { projects } from "../data/projects";

const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith("/") ? rawBase : `${rawBase}/`;
const src = (image: string) => `${base}${image.replace(/^\//, "")}`;
---

<section class="scene work has-deco" id="work">
  <span class="deco orange drift-a" aria-hidden="true" style="width:190px;height:190px;left:-70px;top:16%;transform:rotate(18deg)"></span>
  <span class="deco paper drift-b" aria-hidden="true" style="width:110px;height:110px;left:5%;bottom:70px"></span>
  <div class:list={["work-inner", { "is-empty": projects.length === 0 }]}>
    <h2>{projects.length > 0 ? "דברים שבניתי" : "עוד מעט כאן"}</h2>
    <p class="lead">
      {projects.length > 0 ? "אתרים שכבר עלו לאוויר." : "הדוגמאות יתווספו כאן אחרי השקות."}
    </p>

    {
      projects.length > 0 ? (
        <ol class="works">
          {projects.map((p, i) => {
            const n = String(i + 1).padStart(2, "0");
            const Tag = p.href ? "a" : "div";
            const linkProps = p.href
              ? { href: p.href, target: "_blank", rel: "noopener noreferrer" }
              : {};
            return (
              <li class="piece reveal">
                <Tag class="piece-link" {...linkProps}>
                  <div class="shot">
                    {p.image ? (
                      <img
                        src={src(p.image)}
                        alt={p.imageAlt || p.name}
                        width="1200"
                        height="750"
                        loading="lazy"
                      />
                    ) : (
                      <div class="shot-empty" aria-hidden="true">
                        <span class="blob"></span>
                        <span class="mark">א.</span>
                      </div>
                    )}
                  </div>
                  <div class="meta">
                    <span class="n">{n}</span>
                    <div>
                      <h3>{p.name}</h3>
                      {p.kind && <p class="kind">{p.kind}</p>}
                      {p.text && <p class="text">{p.text}</p>}
                      {p.href && <span class="go">לצפייה באתר</span>}
                    </div>
                  </div>
                </Tag>
              </li>
            );
          })}
        </ol>
      ) : (
        <p class="work-empty" role="status">אין עדיין דוגמאות להצגה. בינתיים אפשר לבחור כיוון ולפתוח מסלול.</p>
        <div class="site-box" aria-hidden="true">
          <div class="box-bar"><i></i><i></i><i></i><span>project-01</span></div>
          <div class="stripes"></div>
          <div class="ghost-lines"><i style="width:180px"></i><i style="width:120px"></i><i style="width:150px"></i></div>
          <span class="tape">בבנייה</span>
        </div>
      )
    }

    <a href="#choose" class="btn btn-primary work-cta">בחרו מה בונים</a>
  </div>
</section>

<style>
  .scene.work {
    background: var(--paper);
    border-top: var(--line);
    padding: var(--sp-section) 0;
  }

  .site-box { position: relative; background: var(--card); border: var(--line); border-radius: 20px; box-shadow: var(--shadow); height: 320px; overflow: hidden; margin-bottom: 32px; }
  .box-bar { height: 40px; border-bottom: var(--line); display: flex; align-items: center; gap: 8px; padding: 0 14px; direction: ltr; }
  .box-bar i { width: 15px; height: 15px; border-radius: 50%; border: var(--line); }
  .box-bar i:first-child { background: var(--accent); }
  .box-bar span { margin-left: 10px; font-size: 13px; color: var(--ink-soft); }
  .stripes { position: absolute; inset: 40px 0 0 0; background: repeating-linear-gradient(-45deg, transparent 0 22px, rgba(255, 75, 38, 0.08) 22px 44px); }
  .ghost-lines { position: absolute; top: 64px; right: 24px; display: grid; gap: 10px; }
  .ghost-lines i { display: block; height: 12px; border-radius: 6px; background: rgba(23, 20, 16, 0.08); }
  .tape { position: absolute; z-index: 3; top: 110px; right: -40px; transform: rotate(18deg); background: var(--accent); color: #fff; border-block: var(--line); font: 600 16px var(--head); padding: 7px 70px; }

  .work-inner {
    width: 100%;
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 20px;
  }

  h2 {
    font-size: clamp(38px, 5.2vw, 68px);
    line-height: 0.95;
    margin-bottom: 16px;
  }

  .lead {
    color: var(--ink-soft);
    font-size: 1.08rem;
    margin-bottom: 36px;
    max-width: 34ch;
  }

  .work-empty {
    color: var(--ink-soft);
    font-size: 1.05rem;
    max-width: 40ch;
    margin: 0 0 36px;
    line-height: 1.5;
  }

  .works {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  .piece-link {
    display: flex;
    flex-direction: column;
    gap: 16px;
    color: inherit;
  }

  a.piece-link {
    border-radius: var(--radius);
  }

  a.piece-link:hover .shot,
  a.piece-link:focus-visible .shot {
    transform: translate(-3px, -3px);
    box-shadow: 7px 7px 0 rgba(255, 75, 38, 0.85);
  }

  .shot {
    border: var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--paper-soft);
    box-shadow: var(--shadow-sm);
    aspect-ratio: 16 / 10;
    transition:
      transform var(--motion) var(--ease),
      box-shadow var(--motion) var(--ease);
  }

  .shot img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .shot-empty {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }

  .blob {
    position: absolute;
    width: 42%;
    height: 58%;
    top: 18%;
    inset-inline-end: -6%;
    background: var(--accent);
    border: var(--line);
    border-radius: 40% 60% 55% 45%;
    transform: rotate(18deg);
    opacity: 0.9;
  }

  .mark {
    position: absolute;
    bottom: 8%;
    inset-inline-start: 8%;
    font-family: var(--head);
    font-size: clamp(4rem, 16vw, 7rem);
    line-height: 1;
    color: var(--ink);
    opacity: 0.1;
  }

  .meta {
    display: grid;
    grid-template-columns: 56px 1fr;
    gap: 14px;
    align-items: start;
  }

  .n {
    font-family: var(--head);
    font-size: 1.4rem;
    color: var(--accent);
  }

  h3 {
    font-size: 1.45rem;
    margin-bottom: 4px;
  }

  .kind {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--accent);
    margin-bottom: 6px;
  }

  .text {
    color: var(--ink-soft);
    font-size: 1rem;
    max-width: 42ch;
  }

  .go {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    margin-top: 4px;
    font-weight: 700;
    color: var(--accent);
  }

  .work-cta {
    margin-top: 40px;
    width: 100%;
    max-width: 320px;
  }

  @media (min-width: 768px) {
    .work-inner {
      padding: 0 32px;
    }
  }

  @media (min-width: 960px) {
    .work-inner.is-empty {
      display: grid;
      grid-template-columns: 1fr 1fr;
      column-gap: clamp(32px, 6vw, 90px);
      align-items: start;
    }
    .work-inner.is-empty > * { grid-column: 1; justify-self: start; }
    .work-inner.is-empty .site-box { grid-column: 2; grid-row: 1 / span 5; justify-self: stretch; height: 380px; margin: 0; }

    .works {
      gap: 56px;
      max-width: 42rem;
    }

    .work-cta {
      width: auto;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    a.piece-link:hover .shot,
    a.piece-link:focus-visible .shot {
      transform: none;
    }
  }
</style>
