---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { projects } from "../data/projects";

// Project screenshots live in src/assets/work and are resized and converted at build time.
const shots = import.meta.glob<{ default: ImageMetadata }>("../assets/work/*.{png,jpg,jpeg,webp,avif}", { eager: true });
const shotFor = (file: string) => {
  const found = shots[`../assets/work/${file}`];
  if (!found) throw new Error(`Project image "${file}" not found in src/assets/work (check the name in src/data/projects.ts)`);
  return found.default;
};

// Until real projects are in, a slow carousel shows the kinds of sites on offer.
const types = [
  { name: "אתר לעסק", url: "my-business", kind: "site" },
  { name: "דף נחיתה", url: "landing", kind: "landing" },
  { name: "חנות אונליין", url: "shop", kind: "shop" },
];
const set = [...types, ...types];   // one set is wider than a wide screen
const track = [...set, ...set];     // two sets: the loop moves by exactly one set
---

<section class="scene work" id="work">
  <div class="container">
    <h2 class="scene-title">תיק עבודות</h2>
    <p class="lead">
      {projects.length > 0 ? "אתרים שכבר עלו לאוויר." : "כרגע אני עובד על פרויקטים שעוד סודיים, אז עדיין אין מה להראות כאן."}
    </p>

    {
      projects.length > 0 ? (
        <ol class="works">
          {projects.map((p, i) => {
            const n = String(i + 1).padStart(2, "0");
            const Tag = p.href ? "a" : "div";
            const linkProps = p.href
              ? { href: p.href, target: "_blank", rel: "noopener noreferrer" }
              : {};
            return (
              <li class="piece reveal">
                <Tag class="piece-link" {...linkProps}>
                  <div class="shot">
                    {p.image ? (
                      <Image
                        src={shotFor(p.image)}
                        alt={p.imageAlt || p.name}
                        widths={[600, 1200]}
                        sizes="(min-width: 960px) 42rem, 100vw"
                        loading="lazy"
                      />
                    ) : (
                      <div class="shot-empty" aria-hidden="true">
                        <span class="blob"></span>
                        <span class="mark">א.</span>
                      </div>
                    )}
                  </div>
                  <div class="meta">
                    <span class="n">{n}</span>
                    <div>
                      <h3>{p.name}</h3>
                      {p.kind && <p class="kind">{p.kind}</p>}
                      {p.text && <p class="text">{p.text}</p>}
                      {p.href && <span class="go">לצפייה באתר</span>}
                    </div>
                  </div>
                </Tag>
              </li>
            );
          })}
        </ol>
      ) : (
        <p class="work-empty" role="status">ברגע שהם יעלו לאוויר, הם יופיעו כאן.</p>
      )
    }

  </div>

  {
    projects.length === 0 && (
      <div class="types" aria-hidden="true">
        <div class="types-track">
          {track.map((t) => (
            <figure class="type">
              <div class:list={["type-win", t.kind]}>
                <div class="box-bar"><i></i><i></i><i></i><span>{t.url}</span></div>
                <div class="sketch">
                  {t.kind === "site" && (
                    <>
                      <div class="nav"><b></b><i></i><i></i><i></i></div>
                      <div class="hero-l"><b style="width:70%"></b><b style="width:48%"></b><i style="width:60%"></i><u></u></div>
                      <div class="cards"><span></span><span></span><span></span></div>
                    </>
                  )}
                  {t.kind === "landing" && (
                    <div class="land"><b style="width:80%"></b><b style="width:56%"></b><i style="width:66%"></i><i style="width:50%"></i><u></u></div>
                  )}
                  {t.kind === "shop" && (
                    <div class="grid">
                      {[0, 1, 2, 3, 4, 5].map(() => <span><em></em><i></i></span>)}
                    </div>
                  )}
                </div>
              </div>
              <figcaption>{t.name}</figcaption>
            </figure>
          ))}
        </div>
      </div>
    )
  }
</section>

<style>
  /* dark section, second on the page */
  .scene.work {
    background: var(--ink);
    color: var(--paper);
    padding: var(--sp-section-lg) 0;
  }

  /* ---- carousel of site types: drifts slowly left to right, endless ---- */
  .types { margin-top: 44px; overflow: hidden; direction: ltr; padding: 6px 0 14px; }
  .types-track { display: flex; gap: 28px; width: max-content; animation: types-drift 70s linear infinite; }
  .types:hover .types-track { animation-play-state: paused; }
  @keyframes types-drift { from { transform: translateX(calc(-50% - 14px)); } to { transform: translateX(0); } }
  .type { flex: none; width: 280px; margin: 0; }
  .type figcaption { margin-top: 14px; text-align: center; font: 600 17px var(--head); color: var(--paper); direction: rtl; }
  .type-win { position: relative; height: 200px; background: var(--card); color: var(--ink); border: var(--line); border-radius: 18px; box-shadow: 8px 8px 0 rgba(246, 241, 231, 0.14); overflow: hidden; }
  .type-win .box-bar { height: 34px; }
  .type-win .box-bar i { width: 12px; height: 12px; }
  .sketch { position: absolute; inset: 34px 0 0 0; padding: 14px 16px; direction: rtl; }
  .sketch b, .sketch i, .sketch u { display: block; border-radius: 4px; }
  .sketch b { height: 10px; background: rgba(23, 20, 16, 0.78); margin-bottom: 6px; }
  .sketch i { height: 6px; background: rgba(23, 20, 16, 0.14); margin-bottom: 6px; }
  .sketch u { width: 64px; height: 18px; border-radius: 6px; background: var(--accent); border: 1.5px solid var(--ink); margin-top: 8px; }
  .nav { display: flex; align-items: center; gap: 8px; margin-bottom: 14px; }
  .nav b { width: 26px; height: 8px; margin: 0 0 0 auto; }
  .nav i { width: 22px; margin: 0; }
  .cards { display: flex; gap: 8px; margin-top: 12px; }
  .cards span { flex: 1; height: 30px; border: 1.5px solid var(--ink); border-radius: 6px; background: var(--paper-soft); }
  .landing .sketch { background: repeating-linear-gradient(-45deg, transparent 0 18px, rgba(255, 75, 38, 0.07) 18px 36px); }
  .land { display: flex; flex-direction: column; align-items: center; padding-top: 10px; }
  .land b, .land i { margin-inline: auto; }
  .land u { width: 92px; height: 22px; }
  .grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; }
  .grid span { display: flex; flex-direction: column; gap: 4px; padding: 5px; border: 1.5px solid var(--ink); border-radius: 6px; background: var(--card); }
  .grid em { display: block; height: 26px; border-radius: 4px; background: var(--paper-soft); }
  .grid span i { width: 60%; height: 5px; margin: 0; background: var(--accent); }
  @media (prefers-reduced-motion: reduce) { .types-track { animation: none; } }

  .box-bar { height: 40px; border-bottom: var(--line); display: flex; align-items: center; gap: 8px; padding: 0 14px; direction: ltr; }
  .box-bar i { width: 15px; height: 15px; border-radius: 50%; border: var(--line); }
  .box-bar i:first-child { background: var(--accent); }
  .box-bar span { margin-left: 10px; font-size: 13px; color: var(--ink-soft); }

  .lead {
    color: var(--on-ink-soft);
    font-size: 1.08rem;
    margin-bottom: 36px;
    max-width: 34ch;
  }

  .work-empty {
    color: var(--on-ink-soft);
    font-size: 1.05rem;
    max-width: 40ch;
    margin: 0 0 36px;
    line-height: 1.5;
  }

  .works {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  .piece-link {
    display: flex;
    flex-direction: column;
    gap: 16px;
    color: inherit;
  }

  a.piece-link {
    border-radius: var(--radius);
  }

  a.piece-link:hover .shot,
  a.piece-link:focus-visible .shot {
    transform: translate(-3px, -3px);
    box-shadow: var(--shadow-hot);
  }

  .shot {
    border: 2px solid var(--paper);
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--paper-soft);
    box-shadow: var(--shadow-sm);
    aspect-ratio: 16 / 10;
    transition:
      transform var(--motion) var(--ease),
      box-shadow var(--motion) var(--ease);
  }

  .shot img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .shot-empty {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }

  .blob {
    position: absolute;
    width: 42%;
    height: 58%;
    top: 18%;
    inset-inline-end: -6%;
    background: var(--accent);
    border: var(--line);
    border-radius: 40% 60% 55% 45%;
    transform: rotate(18deg);
    opacity: 0.9;
  }

  .mark {
    position: absolute;
    bottom: 8%;
    inset-inline-start: 8%;
    font-family: var(--head);
    font-size: clamp(4rem, 16vw, 7rem);
    line-height: 1;
    color: var(--ink);
    opacity: 0.1;
  }

  .meta {
    display: grid;
    grid-template-columns: 56px 1fr;
    gap: 14px;
    align-items: start;
  }

  .n {
    font-family: var(--head);
    font-size: 1.4rem;
    color: #ff6a4a;
  }

  h3 {
    font-size: 1.45rem;
    margin-bottom: 4px;
  }

  .kind {
    font-family: var(--head);
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--accent);
    margin-bottom: 6px;
  }

  .text {
    color: var(--on-ink-soft);
    font-size: 1rem;
    max-width: 42ch;
  }

  .go {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    margin-top: 4px;
    font-family: var(--head);
    font-weight: 700;
    color: var(--accent);
  }

  @media (min-width: 960px) {
    .works {
      gap: 56px;
      max-width: 42rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    a.piece-link:hover .shot,
    a.piece-link:focus-visible .shot {
      transform: none;
    }
  }
</style>
