---
const services = [
  {
    num: "01",
    title: "אתרי איקומרס",
    text: "חנות אונליין עם מוצרים, סליקה ומשלוחים — מסודרת, ברורה, ומוכנה למכירה.",
  },
  {
    num: "02",
    title: "דפי נחיתה",
    text: "עמוד פשוט עם מסר ברור וכפתור ליצירת קשר. בלי סיבוכים מיותרים.",
  },
  {
    num: "03",
    title: "עיצובים ייחודיים",
    text: "כל אתר מותאם לעסק שלכם. באתי מעולם האופנה, אז אני שם לב לפרטים ולמראה הכללי.",
  },
];
---

<section id="services">
  <div class="container">
    <span class="eyebrow">מה אני עושה</span>
    <h2 class="section-title">שירותים</h2>
    <p class="section-subtitle">
      איקומרס, דפי נחיתה ועיצוב מותאם — עם השקעה אמיתית, אמינות ומחיר הוגן.
    </p>
    <div class="grid">
      {
        services.map((s) => (
          <article class="card service reveal">
            <span class="num">{s.num}</span>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 18px;
  }

  .service {
    padding: 26px 24px;
    position: relative;
  }

  .num {
    font-family: "Suez One", serif;
    font-size: 1rem;
    color: #fff;
    background: var(--ink);
    width: 44px;
    height: 44px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 16px;
  }

  .service:nth-child(2) .num {
    background: var(--accent);
  }

  h3 {
    font-size: 1.4rem;
    margin-bottom: 8px;
  }

  .service p {
    color: var(--ink-soft);
    font-size: 1rem;
  }

  @media (min-width: 640px) {
    .grid {
      grid-template-columns: 1fr 1fr;
      gap: 24px;
    }

    .service:last-child {
      grid-column: 1 / -1;
    }
  }

  @media (min-width: 900px) {
    .grid {
      grid-template-columns: 1fr 1fr 1fr;
    }

    .service:last-child {
      grid-column: auto;
    }

    .service {
      padding: 34px 30px;
    }
  }
</style>
