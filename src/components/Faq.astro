---
const faqs = [
  {
    q: "כמה עולה אתר?",
    a: "תלוי בהיקף — דף נחיתה וחנות איקומרס זה לא אותו דבר. אחרי שיחה קצרה תקבלו הצעת מחיר ברורה.",
  },
  {
    q: "מה ההבדל בין המסלולים?",
    a: "מסלול 1 זה בניית האתר עד שאתם מרוצים, כולל בדיקות. מסלול 2 מוסיף תחזוקה חודשית. מסלול 3 מוסיף גם אוטומציות. ואם צריך משהו אחר — נתאים יחד.",
  },
  {
    q: "כמה זמן זה לוקח?",
    a: "דף נחיתה — בדרך כלל עד שבוע. חנות איקומרס — תלוי בכמות המוצרים. בכל פרויקט נסגור לוח זמנים מראש.",
  },
  {
    q: "אפשר לעדכן תוכן לבד?",
    a: "כן. לפי הצורך מחברים מערכת פשוטה ומסבירים איך לעדכן טקסטים ותמונות.",
  },
  {
    q: "מה קורה אחרי שהאתר עולה?",
    a: "במסלול הבסיסי האתר משתחרר אחרי בדיקות. אם תרצו להמשיך עם תחזוקה — יש מסלולים לזה.",
  },
  {
    q: "יש לי כבר אתר ישן — אפשר לשדרג?",
    a: "כן. אפשר לשדרג עיצוב, לבדוק שהכול עובד ולהעביר תוכן — בלי לאבד את הדומיין.",
  },
];
---

<section id="faq">
  <div class="container">
    <span class="eyebrow">שאלות נפוצות</span>
    <h2 class="section-title">שאלות נפוצות</h2>
    <div class="faq-list">
      {
        faqs.map((f) => (
          <details class="card reveal">
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq-list {
    display: flex;
    flex-direction: column;
    gap: 14px;
    max-width: 760px;
  }

  details {
    overflow: hidden;
  }

  summary {
    cursor: pointer;
    font-weight: 700;
    font-size: 1.05rem;
    padding: 18px 20px;
    list-style: none;
    position: relative;
    padding-inline-end: 52px;
    min-height: 52px;
    display: flex;
    align-items: center;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary::after {
    content: "+";
    position: absolute;
    inset-inline-end: 20px;
    top: 50%;
    transform: translateY(-50%);
    font-size: 1.6rem;
    font-weight: 400;
    color: var(--accent);
    transition: transform 0.2s ease;
  }

  details[open] summary::after {
    transform: translateY(-50%) rotate(45deg);
  }

  details p {
    padding: 0 20px 20px;
    color: var(--ink-soft);
  }

  @media (min-width: 820px) {
    summary {
      font-size: 1.12rem;
      padding: 20px 24px;
      padding-inline-end: 56px;
    }
  }
</style>
