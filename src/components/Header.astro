---
import { sections } from "../data/nav";
import { base, homePrefix } from "../data/site";

/** On the home page the links scroll; on any other page they lead back home. */
const home = homePrefix(Astro.url.pathname);
const inBlog = Astro.url.pathname.startsWith(`${base}blog/`);
---

<header class="site-header">
  <div class="container header-inner">
    <a href={home || "#top"} class="logo" translate="no">איליי<span>.</span></a>
    <nav class="nav" id="nav" aria-label="ניווט ראשי">
      {
        sections.map((s) => <a href={`${home}#${s.id}`}>{s.label}</a>)
      }
      <a href={`${home}#choose`} class="nav-cta">בחרו מה בונים</a>
      <a href={`${base}blog/`} aria-current={inBlog ? "page" : undefined}>בלוג</a>
    </nav>
    <button
      class="menu-toggle"
      id="menu-toggle"
      type="button"
      aria-label="פתיחת תפריט"
      aria-controls="nav"
      aria-expanded="false"
    >
      <span></span><span></span>
    </button>
  </div>
</header>

<script>
  const toggle = document.getElementById("menu-toggle");
  const nav = document.getElementById("nav");
  const setOpen = (open: boolean) => {
    if (!toggle || !nav) return;
    nav.classList.toggle("open", open);
    toggle.classList.toggle("active", open);
    toggle.setAttribute("aria-expanded", String(open));
    toggle.setAttribute("aria-label", open ? "סגירת תפריט" : "פתיחת תפריט");
  };
  if (toggle && nav) {
    toggle.addEventListener("click", () => setOpen(!nav.classList.contains("open")));
    nav.addEventListener("click", (e) => {
      if ((e.target as HTMLElement).tagName === "A") setOpen(false);
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") setOpen(false);
    });
  }
</script>

<style>
  .site-header {
    position: fixed;
    inset-inline: 0;
    top: 0;
    z-index: 50;
    padding-top: env(safe-area-inset-top);
    background: rgba(246, 241, 231, 0.92);
    backdrop-filter: blur(10px);
    border-bottom: var(--line);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: var(--header-h);
  }

  .logo {
    font-family: "Suez One", serif; /* the original brand-mark font, kept for "איליי." */
    font-weight: 400;
    font-size: 1.5rem;
  }

  .logo span {
    color: var(--accent);
  }

  .nav {
    position: absolute;
    top: var(--header-h);
    inset-inline: 0;
    display: none;
    flex-direction: column;
    background: var(--paper);
    border-bottom: var(--line);
    padding: 8px 20px 20px;
  }

  .nav.open {
    display: flex;
  }

  /* weights above 400 are set in Fredoka: Varela Round has one weight, and the browser would fake a bold */
  .nav a {
    font-family: var(--head);
    padding: 14px 4px;
    font-size: 1.15rem;
    font-weight: 500;
    border-bottom: 1px solid rgba(23, 20, 16, 0.12);
  }

  .nav a:last-child {
    border-bottom: none;
  }

  .nav-cta {
    color: var(--accent);
  }

  .menu-toggle {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 7px;
    width: 48px;
    height: 48px;
    background: none;
    border: none;
    cursor: pointer;
  }

  .menu-toggle span {
    width: 26px;
    height: 3px;
    background: var(--ink);
    border-radius: 2px;
    transition: transform 0.2s ease;
  }

  .menu-toggle.active span:first-child {
    transform: translateY(5px) rotate(45deg);
  }

  .menu-toggle.active span:last-child {
    transform: translateY(-5px) rotate(-45deg);
  }

  @media (min-width: 768px) {
    .nav {
      position: static;
      display: flex;
      flex-direction: row;
      align-items: center;
      gap: 32px;
      background: none;
      border: none;
      padding: 0;
    }

    .nav a {
      display: inline-flex;
      align-items: center;
      min-height: 44px;
      padding: 4px 0;
      font-size: 1rem;
      font-weight: 600;
      border: none;
      color: var(--ink-soft);
      transition: color var(--motion) var(--ease);
    }

    .nav a:hover,
    .nav a[aria-current="page"] {
      color: var(--ink);
    }

    .nav a[aria-current="page"] {
      box-shadow: 0 3px 0 var(--accent);
    }

    /* after the hover rule, so the call to action stays orange */
    .nav a.nav-cta {
      color: var(--accent);
    }

    .menu-toggle {
      display: none;
    }
  }
</style>
