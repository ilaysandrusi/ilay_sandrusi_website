---
const choices = [
  {
    id: "ecommerce",
    title: "חנות אונליין",
    text: "למכור מוצרים מהאתר: סליקה, קטלוג וסדר.",
    hint: "מסלולים 1–3",
  },
  {
    id: "landing",
    title: "דף נחיתה",
    text: "עמוד אחד שמוביל ליצירת קשר.",
    hint: "מסלולים 1–2",
  },
  {
    id: "unique",
    title: "מסלול משלי, אתה לא תקבע לי",
    text: "אתם קובעים איך זה ייראה ואיך נעבוד.",
    hint: "מסלול 4 בלבד",
  },
];
---

<section class="scene choose" id="choose">
  <div class="choose-inner">
    <p class="eyebrow">בחירה</p>
    <h2>מה אתם צריכים?</h2>
    <p class="lead">בחרו כיוון. החלטה פה תכוון אותכם למסלול המתאים לכם.</p>

    <div class="choices" role="group" aria-label="בחירת סוג אתר">
      {
        choices.map((c) => (
          <button
            type="button"
            class="choice card"
            data-choice={c.id}
            aria-pressed="false"
          >
            <span class="choice-title">{c.title}</span>
            <span class="choice-text">{c.text}</span>
            <span class="choice-hint">{c.hint}</span>
          </button>
        ))
      }
    </div>
  </div>
</section>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>("[data-choice]");
  const plans = document.getElementById("plans");

  const applyFilter = (choice: string | undefined) => {
    if (!plans) return;
    plans.dataset.filter = choice || "";
    plans.querySelectorAll<HTMLElement>("[data-fit]").forEach((card) => {
      const fit = (card.dataset.fit || "").split(/\s+/).filter(Boolean);
      const open = !choice || fit.includes(choice);
      card.classList.toggle("locked", !open);
      card.classList.toggle("spotlight", open && !!choice);
      card.setAttribute("aria-disabled", open ? "false" : "true");

      const badge = card.querySelector(".lock-badge");
      const hint = card.querySelector(".locked-hint");
      badge?.setAttribute("aria-hidden", open ? "true" : "false");
      hint?.setAttribute("aria-hidden", open ? "true" : "false");

      const cta = card.querySelector<HTMLAnchorElement>("a.btn");
      if (cta) {
        if (open) {
          cta.removeAttribute("tabindex");
          cta.removeAttribute("aria-disabled");
          cta.classList.remove("is-disabled");
        } else {
          cta.setAttribute("tabindex", "-1");
          cta.setAttribute("aria-disabled", "true");
          cta.classList.add("is-disabled");
        }
      }
    });
  };

  buttons.forEach((btn) => {
    btn.addEventListener("click", () => {
      const choice = btn.dataset.choice;
      buttons.forEach((b) => {
        const on = b === btn;
        b.classList.toggle("active", on);
        b.setAttribute("aria-pressed", on ? "true" : "false");
      });
      applyFilter(choice);
      plans?.scrollIntoView({ behavior: "smooth", block: "start" });
    });
  });

  // Block clicks on locked plan CTAs
  plans?.addEventListener("click", (e) => {
    const target = e.target as HTMLElement | null;
    const link = target?.closest?.("a.btn");
    if (link?.classList.contains("is-disabled")) {
      e.preventDefault();
    }
  });
</script>

<style>
  .scene.choose {
    min-height: 100svh;
    display: flex;
    align-items: center;
    padding: 90px 0 calc(var(--bar-height) + 32px);
    background: var(--paper-soft);
    border-top: var(--line);
    border-bottom: var(--line);
  }

  .choose-inner {
    width: 100%;
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 20px;
  }

  h2 {
    font-size: clamp(2.2rem, 9vw, 3.6rem);
    margin-bottom: 10px;
  }

  .lead {
    color: var(--ink-soft);
    font-size: 1.08rem;
    margin-bottom: 28px;
    max-width: 34ch;
  }

  .choices {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .choice {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 6px;
    width: 100%;
    min-height: 44px;
    text-align: start;
    padding: 22px 20px;
    cursor: pointer;
    font-family: inherit;
    color: inherit;
    transition:
      transform var(--motion) var(--ease),
      background var(--motion) var(--ease),
      color var(--motion) var(--ease),
      box-shadow var(--motion) var(--ease);
  }

  .choice:hover,
  .choice.active {
    background: var(--ink);
    color: var(--paper);
    transform: translate(-3px, -3px);
    box-shadow: 7px 7px 0 rgba(255, 75, 38, 0.85);
  }

  .choice:active {
    transform: translate(0, 0);
    box-shadow: 3px 3px 0 rgba(255, 75, 38, 0.85);
  }

  .choice-title {
    font-family: "Suez One", serif;
    font-size: 1.45rem;
  }

  .choice-text {
    font-size: 1rem;
    opacity: 0.85;
  }

  .choice-hint {
    margin-top: 6px;
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--accent);
  }

  .choice.active .choice-hint,
  .choice:hover .choice-hint {
    color: var(--accent);
  }

  @media (min-width: 768px) {
    .choose-inner {
      padding: 0 32px;
    }

    .choices {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 18px;
    }

    .choice {
      min-height: 220px;
      justify-content: flex-end;
      padding: 28px 24px;
    }
  }
</style>
