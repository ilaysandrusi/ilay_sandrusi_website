---
// the choices and the plans they open are listed in src/data/plans.ts
import { choiceHint, choices } from "../data/plans";
---

<section class="scene choose has-deco" id="choose">
  <span class="deco paper drift-b" aria-hidden="true" style="width:120px;height:120px;left:5%;bottom:70px"></span>
  <span class="deco orange drift-a" aria-hidden="true" style="width:130px;height:130px;left:-40px;top:80px;transform:rotate(-12deg)"></span>
  <div class="container">
    <h2 class="scene-title">מה בונים עכשיו?</h2>
    <p class="lead">בחרו כיוון. אפתח רק את המסלולים שמתאימים.</p>

    <div class="choices" role="group" aria-label="בחירת סוג אתר">
      {
        choices.map((c, i) => (
          <button
            type="button"
            class="choice card reveal"
            style={`--reveal-delay: ${i * 80}ms`}
            data-choice={c.id}
            data-label={c.title}
            aria-pressed="false"
          >
            <span class="ic" aria-hidden="true" set:html={c.icon} />
            <span class="choice-title">{c.title}</span>
            <span class="choice-text">{c.text}</span>
            <span class="choice-hint">{choiceHint(c.id)}</span>
          </button>
        ))
      }
    </div>
    <p class="sr-only" id="plans-filter-status" aria-live="polite"></p>
  </div>
</section>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>("[data-choice]");
  const plans = document.getElementById("plans");
  const status = document.getElementById("plans-filter-status");
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  const applyFilter = (choice: string | undefined) => {
    if (!plans) return;
    plans.dataset.filter = choice || "";
    plans.querySelectorAll<HTMLElement>("[data-fit]").forEach((card) => {
      const fit = (card.dataset.fit || "").split(/\s+/).filter(Boolean);
      const open = !choice || fit.includes(choice);
      card.classList.toggle("locked", !open);
      card.classList.toggle("spotlight", open && !!choice);
      card.setAttribute("aria-disabled", open ? "false" : "true");

      const badge = card.querySelector(".lock-badge");
      const hint = card.querySelector(".locked-hint");
      badge?.setAttribute("aria-hidden", open ? "true" : "false");
      hint?.setAttribute("aria-hidden", open ? "true" : "false");

      const cta = card.querySelector<HTMLAnchorElement>("a.btn");
      if (cta) {
        if (open) {
          cta.removeAttribute("tabindex");
          cta.removeAttribute("aria-disabled");
          cta.classList.remove("is-disabled");
        } else {
          cta.setAttribute("tabindex", "-1");
          cta.setAttribute("aria-disabled", "true");
          cta.classList.add("is-disabled");
        }
      }
    });

    if (status) {
      status.textContent = choice
        ? `נפתחו מסלולים ל${[...buttons].find((b) => b.dataset.choice === choice)?.dataset.label ?? choice}.`
        : "";
    }
  };

  const setChoice = (choice: string, scroll = false) => {
    buttons.forEach((b) => {
      const on = b.dataset.choice === choice;
      b.classList.toggle("active", on);
      b.setAttribute("aria-pressed", on ? "true" : "false");
    });
    applyFilter(choice);
    const url = new URL(window.location.href);
    url.searchParams.set("need", choice);
    history.replaceState(null, "", url);
    if (scroll) {
      plans?.scrollIntoView({ behavior: reduceMotion ? "auto" : "smooth", block: "start" });
    }
  };

  buttons.forEach((btn) => {
    btn.addEventListener("click", () => {
      const choice = btn.dataset.choice;
      if (!choice) return;
      setChoice(choice, true);
    });
  });

  const initial = new URLSearchParams(window.location.search).get("need");
  if (initial && [...buttons].some((b) => b.dataset.choice === initial)) {
    setChoice(initial, false);
  }

  // Block clicks on locked plan CTAs
  plans?.addEventListener("click", (e) => {
    const target = e.target as HTMLElement | null;
    const link = target?.closest?.("a.btn");
    if (link?.classList.contains("is-disabled")) {
      e.preventDefault();
    }
  });
</script>

<style>
  .scene.choose {
    padding: var(--sp-section) 0;
    background: var(--paper);
    border-top: var(--line);
    border-bottom: var(--line);
  }

  .ic { width: 52px; height: 52px; border: var(--line); border-radius: 14px; display: grid; place-items: center; background: var(--paper); color: var(--ink); margin-bottom: 10px; }
  .ic :global(svg) { width: 26px; height: 26px; }
  .choice:hover .ic, .choice.active .ic { background: var(--accent); color: #fff; }

  .lead {
    color: var(--ink-soft);
    font-size: 1.08rem;
    margin-bottom: 28px;
    max-width: 52ch;
    text-wrap: pretty;
  }

  .choices {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .choice {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 6px;
    width: 100%;
    min-height: 44px;
    text-align: start;
    padding: 22px 20px;
    cursor: pointer;
    font-family: inherit;
    color: inherit;
    transition:
      transform var(--motion) var(--ease),
      background var(--motion) var(--ease),
      color var(--motion) var(--ease),
      box-shadow var(--motion) var(--ease);
  }

  .choice:hover,
  .choice.active {
    background: var(--ink);
    color: var(--paper);
    transform: translate(-3px, -3px);
    box-shadow: var(--shadow-hot);
  }

  .choice:active {
    transform: translate(0, 0);
    box-shadow: 3px 3px 0 var(--accent-shadow);
  }

  .choice-title {
    font-family: var(--head);
    font-weight: 700;
    font-size: 26px;
    letter-spacing: -0.02em;
  }

  .choice-text {
    font-size: 1rem;
    opacity: 0.85;
  }

  .choice-hint {
    font-family: var(--head);
    margin-top: 6px;
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--accent);
  }

  .choice.active .choice-hint,
  .choice:hover .choice-hint {
    color: var(--accent);
  }

  @media (prefers-reduced-motion: reduce) {
    .choice,
    .choice:hover,
    .choice.active,
    .choice:active {
      transition: none;
      transform: none;
    }
  }

  @media (min-width: 768px) {
    .choices {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 18px;
    }

    .choice {
      min-height: 230px;
      justify-content: flex-start;
      padding: 30px 28px 26px;
    }
    .choice-hint { margin-top: auto; }
  }
</style>
